<?xml version="1.0" encoding="utf-8"?>
<!-- An exception that escapes on a background or finalizer thread is
     reported instead of ending Media Center: large parts of it lean on
     Windows services that have no stand-in yet (see WmcStandins/Guard.cs). -->
<configuration>
  <runtime>
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
